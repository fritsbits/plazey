---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import ProgramCard from '../../../components/ProgramCard.astro';
import { getCollection, render } from 'astro:content';
import { SITE_PHASE, SHOW_ACT_TIMES, FACEBOOK_URL } from '../../../config/site.ts';
import { typeGroups, typeGroupLabels } from '../../../config/programme-labels';

const allItems = await getCollection('programme');
const items = allItems
  .filter(e => e.id.startsWith('fr/') && !e.data.draft)
  .sort((a, b) => {
    const dayOrder: Record<string, number> = { friday: 0, saturday: 1, sunday: 2 };
    const dayDiff = (dayOrder[a.data.day] ?? 0) - (dayOrder[b.data.day] ?? 0);
    if (dayDiff !== 0) return dayDiff;
    return a.data.startTime.localeCompare(b.data.startTime);
  });

// Le corps markdown se déplie dans la carte. Les items sans corps (et sans
// embed/artiste) restent des cartes statiques : aucun clic sans suite.
const withContent = await Promise.all(
  items.map(async item => ({
    item,
    Content: item.body?.trim() ? (await render(item)).Content : null,
  }))
);

// On n'affiche une puce que si son groupe a vraiment des items. Combiné au
// choix unique, un résultat vide devient impossible : pas d'état vide à gérer.
// L'ordre suit ces listes.
const presentDays = new Set<string>(items.map(e => e.data.day));
const presentTypes = new Set<string>(items.map(e => e.data.type));

// `iso` est ce que le script « aujourd'hui » compare à l'horloge du navigateur.
// Le site est un build statique qui ne se redéploie qu'à un enregistrement dans
// le CMS : impossible de déterminer le jour au moment du build.
const days = [
  { value: 'friday', label: 'Vendredi 28 août', weekday: 'Vendredi', date: '28 août', iso: '2026-08-28' },
  { value: 'saturday', label: 'Samedi 29 août', weekday: 'Samedi', date: '29 août', iso: '2026-08-29' },
  { value: 'sunday', label: 'Dimanche 30 août', weekday: 'Dimanche', date: '30 août', iso: '2026-08-30' },
].filter(d => presentDays.has(d.value));

const groups = typeGroups
  .map(g => ({
    value: g.value,
    label: typeGroupLabels.fr[g.value],
    types: g.types.filter(t => presentTypes.has(t)),
  }))
  .filter(g => g.types.length > 0);
---

<BaseLayout title="Programme" lang="fr" currentPath="/fr/programme" bodyClass="page-programme">
  <img src="/decor/basiliek.png" alt="" aria-hidden="true" class="programme-basiliek" width="1047" height="844" />
  <img src="/decor/trees-lamps.png" alt="" aria-hidden="true" class="programme-trees" width="1166" height="1554" />
  <section class="section hero-intro section--green">
    <Container>
      <div class="programme-title-row">
        <h1>Programme</h1>
        {SITE_PHASE !== 'save-the-date' && days.length > 1 && (
          <nav class="day-jump" aria-label="Aller à un jour">
            {days.map(d => (
              <a href={`#day-${d.value}`} data-day={d.value} data-date={d.iso}>{d.weekday}</a>
            ))}
          </nav>
        )}
      </div>

      {SITE_PHASE === 'save-the-date' ? (
        <>
          <p class="opening">Le programme 2026 arrive bientôt.</p>
          <p><a href={FACEBOOK_URL} rel="external noopener" target="_blank">Suis-nous sur Facebook pour l'annonce.</a></p>
        </>
      ) : (
        <>
          <p class="opening">28–30 août 2026. Tout est gratuit.</p>
          {!SHOW_ACT_TIMES && <p class="text-meta">Les horaires détaillés par acte suivront bientôt.</p>}

          {SITE_PHASE === 'aftermovie' && (
            <div role="note" class="season-banner my-4 p-4 image-rounded" style="background: var(--color-surface-muted);">
              <p>C'était le programme de Plazey 2026.</p>
            </div>
          )}

      <div class="filter-section">
        <div id="type-filter" class="programme-filter" role="group" aria-label="Filtrer par type" hidden>
          {groups.map(g => (
            <button type="button" class="filter-pill" data-type={g.value} data-types={g.types.join(' ')} aria-pressed="false">{g.label}</button>
          ))}
        </div>
      </div>

      <div role="status" aria-live="polite" aria-atomic="true" id="filter-status" class="sr-only"></div>

      <div id="programme-list">
        {days.map(day => {
          const dayItems = withContent.filter(({ item }) => item.data.day === day.value);
          if (dayItems.length === 0) return null;
          return (
            <section data-day={day.value} data-date={day.iso} aria-labelledby={`day-${day.value}`}>
              <h2 id={`day-${day.value}`} class="day-header">
                <span class="day-header-weekday">{day.weekday}</span> <span class="day-header-date">{day.date}</span>
              </h2>
              <ul role="list" class="program-cards columns-1 sm:columns-2 lg:columns-3 gap-4">
                {dayItems.map(({ item, Content }) => {
                  const cardProps = {
                    title: item.data.title,
                    startTime: item.data.startTime,
                    type: item.data.type,
                    dayLabel: day.label,
                    lang: 'fr' as const,
                    ...(item.data.stage && { stage: item.data.stage }),
                    ...(item.data.timeChange && { timeChange: item.data.timeChange }),
                    ...(item.data.endTime && { endTime: item.data.endTime }),
                    ...(item.data.allDay && { allDay: true }),
                    ...(item.data.curator && { curator: item.data.curator }),
                    ...(item.data.genre && { subtitle: item.data.genre }),
                    ...(item.data.description && { description: item.data.description }),
                    ...(item.data.artist && { artist: item.data.artist }),
                    ...(item.data.embedUrl && { embedUrl: item.data.embedUrl }),
                  };
                  return (
                    <li class="mb-4 break-inside-avoid" data-type={item.data.type} data-day={item.data.day}>
                      {Content ? (
                        <ProgramCard {...cardProps}><Content /></ProgramCard>
                      ) : (
                        <ProgramCard {...cardProps} />
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          );
        })}
      </div>

        </>
      )}
    </Container>

    <div class="programme-illustrations" aria-hidden="true">
      <img src="/decor/basiliek.png" alt="" width="1047" height="844" />
      <img src="/decor/trees-lamps.png" alt="" width="1166" height="1554" />
    </div>
  </section>
</BaseLayout>

<script>
  // Un seul axe de filtrage : le type. Les jours sont la structure de la page
  // (titres + liens d'ancrage), pas un état — on les voit déjà en défilant.
  const bar = document.getElementById('type-filter');
  const status = document.getElementById('filter-status');
  const list = document.getElementById('programme-list');
  const jump = document.querySelector<HTMLElement>('.day-jump');

  // Le programme (et tout ce bloc) est absent en phase save-the-date.
  if (bar && status && list) {
    // Les puces ne font rien sans JS : on ne les affiche qu'une fois le script actif.
    bar.hidden = false;

    const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>('button[data-type]'));
    // Une puce couvre plusieurs types de contenu : on teste l'appartenance
    // plutôt que l'égalité. Clé de la puce → les types qu'elle représente.
    const members = new Map(chips.map(c => [c.dataset.type!, new Set((c.dataset.types ?? '').split(' '))]));
    let active: string | null = null;

    // `announce` reste false au premier rendu : la zone live ne doit pas
    // annoncer un décompte que personne n'a demandé.
    function apply(announce: boolean) {
      let visible = 0;
      list!.querySelectorAll<HTMLElement>('li[data-type]').forEach(card => {
        const show = !active || !!members.get(active)?.has(card.dataset.type!);
        card.hidden = !show;
        if (show) visible++;
      });

      // On masque le titre d'un jour, et son lien d'ancrage, quand aucune de ses
      // cartes ne passe le filtre. On cible section[data-day] : les cartes
      // portent aussi data-day, donc un simple [data-day] les masquerait à tort.
      list!.querySelectorAll<HTMLElement>('section[data-day]').forEach(section => {
        const empty = !section.querySelector('li[data-type]:not([hidden])');
        section.hidden = empty;
        const link = jump?.querySelector<HTMLElement>(`a[data-day="${section.dataset.day}"]`);
        if (link) link.hidden = empty;
      });

      chips.forEach(c => c.setAttribute('aria-pressed', String(c.dataset.type === active)));

      if (announce) {
        status!.textContent = `${visible} résultat${visible > 1 ? 's' : ''}.`;
      }

      const url = new URL(window.location.href);
      if (active) url.searchParams.set('type', active); else url.searchParams.delete('type');
      window.history.replaceState({}, '', url.toString());
    }

    bar.addEventListener('click', e => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-type]');
      if (!chip) return;
      // Recliquer sur la puce active la désactive : on revient à tout afficher.
      active = active === chip.dataset.type ? null : chip.dataset.type!;
      apply(true);
    });

    // Une clé de puce l'emporte ; sinon on retombe sur le groupe qui contient
    // ce type, pour que les liens partagés avant le regroupement (?type=expo)
    // atterrissent sur la bonne puce au lieu de tout afficher.
    function resolve(value: string | null | undefined): string | null {
      if (!value) return null;
      if (members.has(value)) return value;
      for (const [key, types] of members) if (types.has(value)) return key;
      return null;
    }

    active = resolve(new URLSearchParams(window.location.search).get('type'));
    apply(false);

    // The chip bar rides under the nav for the whole list. A sentinel in the
    // bar's original place flips `data-stuck`, so the bar only paints its
    // background once it has really left the flow — parked in place it stays
    // transparent over the section's textured green. Sentinel and measurement
    // are built here rather than in the markup: without JS there are no chips,
    // so there is nothing to stick.
    const section = bar.closest<HTMLElement>('.filter-section');
    if (section) {
      const root = document.documentElement;
      // Day anchors offset by this, so their heading clears the bar.
      const setFilterHeight = () =>
        root.style.setProperty('--filter-height', `${section.offsetHeight}px`);
      new ResizeObserver(setFilterHeight).observe(section);
      setFilterHeight();

      const sentinel = document.createElement('div');
      sentinel.setAttribute('aria-hidden', 'true');
      sentinel.style.cssText = 'height:1px;margin-bottom:-1px;pointer-events:none';
      section.before(sentinel);

      // rootMargin has to match the nav's real height, so rebuild on resize.
      let io: IntersectionObserver | null = null;
      const watch = () => {
        io?.disconnect();
        const headerH =
          parseFloat(getComputedStyle(root).getPropertyValue('--header-height')) || 53;
        io = new IntersectionObserver(
          entries => {
            const entry = entries[entries.length - 1];
            if (!entry) return;
            // Not `!isIntersecting`: that is also true while the sentinel is
            // still below the fold, which would stick the bar before you reach it.
            const passed = entry.boundingClientRect.top < (entry.rootBounds?.top ?? 0);
            section.toggleAttribute('data-stuck', passed);
          },
          { rootMargin: `-${headerH + 1}px 0px 0px 0px` }
        );
        io.observe(sentinel);
      };
      watch();
      window.addEventListener('resize', watch, { passive: true });
    }
  }

  // Le jour courant vient du navigateur : ce build statique n'est redéployé
  // qu'à un enregistrement dans le CMS. Piloté par la date et non par la phase,
  // donc juste le jour même même si la phase n'est jamais basculée. En dehors du
  // week-end du festival rien ne correspond et la page reste telle quelle.
  const daySections = Array.from(
    document.querySelectorAll<HTMLElement>('#programme-list section[data-date]')
  );
  const now = new Date();
  const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
  const currentDay = daySections.find(s => s.dataset.date === today);

  if (currentDay) {
    // Les dates ISO se comparent correctement comme des chaînes, un `<` suffit.
    jump?.querySelectorAll<HTMLAnchorElement>('a[data-date]').forEach(link => {
      const date = link.dataset.date!;
      if (date === today) link.setAttribute('aria-current', 'date');
      else if (date < today) link.setAttribute('data-past', '');
    });

    const header = currentDay.querySelector('.day-header');
    if (header) {
      const badge = document.createElement('span');
      badge.className = 'day-today-badge';
      badge.textContent = "Aujourd'hui";
      header.append(' ', badge);
    }

    // Le premier jour, le haut de page est déjà le bon : on laisse le lecteur
    // où il a atterri. À partir du deuxième jour, une visite sans filtre
    // ouvrirait sur un jour déjà passé. Ignoré si le lecteur a demandé quelque
    // chose de précis (ancre de jour, filtre de type) ou si le navigateur a
    // restauré une position de défilement.
    const params = new URLSearchParams(window.location.search);
    if (
      currentDay !== daySections[0] &&
      !window.location.hash &&
      !params.get('type') &&
      window.scrollY < 10
    ) {
      // On se ré-ancre une fois la police d'affichage et les images chargées :
      // les deux modifient la hauteur de tout ce qui précède aujourd'hui, donc
      // un seul défilement ici finit au milieu de la veille. Le moindre geste de
      // défilement du lecteur l'emporte et nous arrête.
      let readerMoved = false;
      const release = () => { readerMoved = true; };
      ['wheel', 'touchstart', 'keydown'].forEach(type =>
        window.addEventListener(type, release, { passive: true, once: true })
      );

      // On fait défiler le titre, pas la section : `scroll-margin-top` (qui
      // dégage la nav collante et la barre de puces) est sur `.day-header`.
      // Viser la section coince le titre sous les deux.
      const anchor = () => {
        if (!readerMoved) (header ?? currentDay).scrollIntoView({ block: 'start' });
      };
      anchor();
      document.fonts?.ready.then(anchor);
      window.addEventListener('load', anchor);
    }
  }
</script>
